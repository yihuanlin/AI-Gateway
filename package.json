    "@ai-sdk/openai-compatible": "^2.0.47",
    "@ai-sdk/xai": "^3.0.91",
    "@huggingface/inference": "^4.13.18",
    "ai": "^6.0.189",
    "hono": "^4.12.21",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}