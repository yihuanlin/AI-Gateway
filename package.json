    "@ai-sdk/openai-compatible": "^3.0.30",
    "@ai-sdk/xai": "^4.0.38",
    "@huggingface/inference": "^4.13.26",
    "ai": "^7.0.65",
    "hono": "^4.13.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "typescript": "^5.9.3"
  }
}